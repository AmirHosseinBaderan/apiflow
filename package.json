{
  "name": "api-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted API Testing & Workflow Platform",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vue/compiler-dom": "^3.5.42",
    "axios": "^1.20.0",
    "pinia": "~2.2.6",
    "vue": "~3.5.13",
    "vue-router": "~4.4.5",
    "vuetify": "~3.7.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.1",
    "sass": "^1.81.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.3",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
